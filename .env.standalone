# =============================================================================
# Rust URL Shortener - Standalone Mode
# =============================================================================
# Build with: cargo build --release --features standalone
# Docker:     docker build --build-arg BUILD_MODE=standalone -t rus:standalone .

###############################################################################
# ---- Standalone-Only Configuration ----
###############################################################################

# JWT secret key (required)
# Generate a secure random string for production
# You can use: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production

# JWT access token expiry in hours (optional, defaults to 1)
# JWT_EXPIRY=1

# Refresh token expiry in days (optional, defaults to 7)
# REFRESH_TOKEN_EXPIRY=7

# Number of failed login attempts before account lockout (optional, defaults to 5)
# ACCOUNT_LOCKOUT_ATTEMPTS=5

# Account lockout duration in minutes (optional, defaults to 30)
# ACCOUNT_LOCKOUT_DURATION=30

# Allow new user registrations (optional, defaults to true)
# Set to false to disable public signups (admin users can still be created via setup)
# ALLOW_REGISTRATION=true

###############################################################################
# ---- Shared Configuration ----
###############################################################################

# =============================================================================
# Host Configuration
# =============================================================================
# Server host (optional, defaults to 0.0.0.0)
# Note: APP_HOST avoids collision with the system's HOST hostname variable
# APP_HOST=0.0.0.0

# Server port (optional, defaults to 4001)
# APP_PORT=4001

# Docker host IP binding (optional, defaults to 127.0.0.1)
# HOST_IP=127.0.0.1

# Docker host port mapping (optional, defaults to 4001)
# HOST_PORT=4001

# Public-facing URL used when generating shortened links
# (optional, defaults to http://localhost:4001)
# HOST_URL=http://localhost:4001

# =============================================================================
# Database Configuration
# =============================================================================
# Database path (optional, defaults to ./data/rus.db; Docker default: /data/rus.db)
# DB_PATH=./data/rus.db

# =============================================================================
# Application Configuration
# =============================================================================
# Maximum allowed length for URLs to be shortened (optional, defaults to 2048)
# MAX_URL_LENGTH=2048

# Number of days to retain click history (optional, defaults to 30)
# CLICK_RETENTION_DAYS=30

# =============================================================================
# Security Alerts
# =============================================================================
# Email one operator mailbox when an account signs in from a country it has not
# signed in from before. The country comes from the X-IPCountry header injected
# by the reverse proxy's geoblock middleware; with no such edge no country
# resolves and no alert is raised.

# Operator mailbox that receives the alerts. Unset means the alert is logged
# rather than sent.
# SECURITY_ALERT_EMAIL=security@example.com

# Global kill switch (optional, defaults to true). Set to false, 0, or no to
# turn the alert off entirely.
# LOGIN_LOCATION_ALERTS_ENABLED=true

# SMTP delivery. SMTP_HOST, SMTP_FROM_EMAIL, and SECURITY_ALERT_EMAIL must all
# be set before an alert is actually sent; otherwise it is only logged.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=25
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@example.com
# SMTP_FROM_NAME=RUS

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level filter (optional, defaults to info,rus=debug)
# See https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html
# RUST_LOG=info,rus=debug
